# Example site: a made-up house. Copy this folder to site/<your-name>/, change each value, then run
#   python3 tools/render-site.py site/<your-name>
# Format: KEY=value, one per line, no quotes. SETUP-QUESTIONS.md says where each answer comes from.

# LAN: the first three octets of the house /24. The firewall is .1; host numbers in the files keep their octet.
LAN_PREFIX=192.168.50

# The one outside address allowed in to the RustDesk server on the admin PC (TCP 21115-21117, UDP 21116).
REMOTE_SRC=203.0.113.45
# A short name for that remote site, used in the daily brief.
REMOTE_NAME=Acme
# The DDNS name the remote RustDesk client uses for this house.
DDNS_NAME=rustdesk.home.example

# Host names. ADMIN_HOST is the admin PC (pulls the backups, runs RustDesk); LOG_HOST is the old syslog collector.
ADMIN_HOST=ADMINPC
ADMIN_HOST_LC=adminpc
LOG_HOST=LOGHOST
# The test client cabled to trunk0 when the box runs the bench profile.
BENCH_CLIENT=laptop1

# WAN MAC to clone (the old router's WAN MAC, so the ISP keeps the same lease). Lower and upper case.
WAN_CLONE_MAC=00:00:5e:00:53:01
WAN_CLONE_MAC_UC=00:00:5E:00:53:01

# The box's own ports, by permanent MAC (tools/nic-macs.sh prints them).
MGMT0_MAC=00:00:5e:00:53:10
WAN0_MAC=00:00:5e:00:53:11
TRUNK0_MAC=00:00:5e:00:53:12
SPARE2_MAC=00:00:5e:00:53:13
SPARE3_MAC=00:00:5e:00:53:14

# --- Installer (installer/BUILD.md). These go into the installer image, not into the firewall config.
# The identity that etckeeper uses for its commits of /etc on the box. One word each, no spaces.
ETC_GIT_NAME=firewall-admin
ETC_GIT_EMAIL=firewall@home.example
# Time zone of the house (a name from /usr/share/zoneinfo). Reports and the log database use local time.
TIME_ZONE=America/New_York
# The disk the installer ERASES and installs to. NVMe: /dev/nvme0n1. SATA: usually /dev/sda.
INSTALL_DISK=/dev/nvme0n1
# Safety guard: the automated install only starts if the text in HW_MODEL_FILE matches HW_MODEL_REGEX
# (grep -iE, no single quotes). Lenovo puts the model name in product_version; most other makers use
# /sys/class/dmi/id/product_name. On any other machine the install stops before it touches a disk.
HW_MODEL_FILE=/sys/class/dmi/id/product_version
HW_MODEL_REGEX=ThinkCentre M(920q|920x|720q)
