[Unit]
Description=Archive the finished weeks of the firewall database

[Service]
Type=oneshot
User=fwdb
Group=adm
UMask=0027
ExecStart=/usr/local/sbin/fw-archive
TimeoutStartSec=2h
Nice=10
MemoryMax=8G
Environment=PYTHONDONTWRITEBYTECODE=1 HOME=/var/lib/fwdb
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/fwdb
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectKernelLogs=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
