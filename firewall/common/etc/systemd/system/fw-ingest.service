[Unit]
Description=Load logs and traffic counters into the firewall database
After=fw-flowd.service

[Service]
Type=oneshot
User=fwdb
Group=adm
UMask=0027
ExecStart=/usr/local/sbin/fw-ingest
TimeoutStartSec=15min
Nice=10
IOWeight=20
CPUWeight=20
MemoryMax=8G
Environment=PYTHONDONTWRITEBYTECODE=1 HOME=/var/lib/fwdb
CapabilityBoundingSet=
RestrictAddressFamilies=AF_NETLINK AF_UNIX
ReadWritePaths=/var/lib/fwdb
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectKernelLogs=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
