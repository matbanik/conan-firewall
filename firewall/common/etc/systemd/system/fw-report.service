[Unit]
Description=Daily database report
# The brief is written even when a query failed: the report says which one.
OnSuccess=fw-brief.service
OnFailure=fw-brief.service

[Service]
Type=oneshot
User=fwdb
Group=adm
UMask=0027
# fw-updates (read-only) needs root for the unattended-upgrades log and needrestart: '+' runs it without this
# sandbox, '-' keeps the report going if it fails (the report then says the updates part is missing).
ExecStartPre=-+/usr/local/sbin/fw-updates /var/lib/fwdb/reports/updates.txt
ExecStart=/usr/local/sbin/fw-report
TimeoutStartSec=20min
Nice=10
MemoryMax=8G
Environment=PYTHONDONTWRITEBYTECODE=1 HOME=/var/lib/fwdb
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/fwdb
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectKernelLogs=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
